 /// The app's text system, recorded at startup so `fontFamily` lists can see which families exist.
 pub(crate) static TEXT_SYSTEM: OnceLock<Arc<gpui::TextSystem>> = OnceLock::new();
 
+const SYSTEM_UI_FONT: &str = ".SystemUIFont";
+
+fn installed_font_names() -> Option<&'static [String]> {
+    static INSTALLED: OnceLock<Vec<String>> = OnceLock::new();
+    let text_system = TEXT_SYSTEM.get()?;
+    Some(INSTALLED.get_or_init(|| text_system.all_font_names()))
+}
+
+/// The desktop's UI font: fontconfig's `sans-serif`, since GPUI maps `.SystemUIFont` to IBM Plex
+/// Sans on Linux, which is rarely installed. `None` keeps GPUI's mapping.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn system_ui_font() -> Option<&'static str> {
+    use font_kit::{family_name::FamilyName, properties::Properties, source::SystemSource};
+    static FAMILY: OnceLock<Option<String>> = OnceLock::new();
+    FAMILY
+        .get_or_init(|| {
+            let family = SystemSource::new()
+                .select_best_match(&[FamilyName::SansSerif], &Properties::new())
+                .ok()?
+                .load()
+                .ok()?
+                .family_name();
+            installed_font_names()?.contains(&family).then_some(family)
+        })
+        .as_deref()
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "freebsd")))]
+fn system_ui_font() -> Option<&'static str> {
+    None
+}
