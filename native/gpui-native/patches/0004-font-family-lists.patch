+/// The app's text system, recorded at startup so `fontFamily` lists can see which families exist.
+pub(crate) static TEXT_SYSTEM: OnceLock<Arc<gpui::TextSystem>> = OnceLock::new();
+
+/// Applies a CSS-like `fontFamily` list: the first installed family becomes the font and the
+/// families after it its per-glyph fallbacks. GPUI drops a font's fallbacks along with a family
+/// it cannot load, so a missing first choice must not be the font.
+fn apply_font_family<E: gpui::Styled>(mut el: E, list: &str) -> E {
+    let mut families: Vec<String> = list
+        .split(',')
+        .map(|family| family.trim().trim_matches(['"', '\'']).to_string())
+        .filter(|family| !family.is_empty())
+        .collect();
+    if families.len() > 1 {
+        static INSTALLED: OnceLock<Vec<String>> = OnceLock::new();
+        if let Some(text_system) = TEXT_SYSTEM.get() {
+            let installed = INSTALLED.get_or_init(|| text_system.all_font_names());
+            if let Some(first) = families.iter().position(|family| installed.contains(family)) {
+                families.drain(..first);
+            }
+        }
+    }
+    let mut families = families.into_iter();
+    let Some(family) = families.next() else {
+        return el;
+    };
+    el = el.font_family(family);
+    let fallbacks: Vec<String> = families.collect();
+    if !fallbacks.is_empty() {
+        el.text_style().font_fallbacks = Some(gpui::FontFallbacks::from_fonts(fallbacks));
+    }
+    el
+}
