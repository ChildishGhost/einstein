+/// X11 popups (and the layer-shell fallback) open where a top-anchored layer surface sits:
+/// centered horizontally, `layer_margin_top` below the display top. Explicit `x`/`y` win.
+#[cfg(target_os = "linux")]
+fn popup_bounds(
+    options: &WindowOptions,
+    bounds: gpui::Bounds<gpui::Pixels>,
+    display: Option<gpui::Bounds<gpui::Pixels>>,
+    layer_shell: bool,
+) -> gpui::Bounds<gpui::Pixels> {
+    let popup = match options.kind.as_deref() {
+        Some("popup") => true,
+        Some("layerShell") => !layer_shell,
+        _ => false,
+    };
+    match display {
+        Some(display) if popup && (options.x.is_none() || options.y.is_none()) => gpui::Bounds {
+            origin: gpui::point(
+                display.origin.x + (display.size.width - bounds.size.width) * 0.5,
+                display.origin.y + gpui::px(options.layer_margin_top.unwrap_or(160.0) as f32),
+            ),
+            size: bounds.size,
+        },
+        _ => bounds,
+    }
+}
