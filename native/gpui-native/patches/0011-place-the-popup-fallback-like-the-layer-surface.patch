+    #[cfg(target_os = "linux")]
+    #[test]
+    fn x11_popups_open_where_the_layer_surface_would() {
+        let px = |value: f32| gpui::px(value);
+        let centered = gpui::Bounds {
+            origin: gpui::point(px(440.0), px(372.0)),
+            size: gpui::size(px(600.0), px(56.0)),
+        };
+        let display = Some(gpui::Bounds {
+            origin: gpui::point(px(1280.0), px(0.0)),
+            size: gpui::size(px(1280.0), px(800.0)),
+        });
+        let with = |kind: &str, margin: Option<f64>| WindowOptions {
+            kind: Some(kind.to_string()),
+            layer_margin_top: margin,
+            ..WindowOptions::default()
+        };
+
+        let placed = popup_bounds(&with("layerShell", Some(120.0)), centered, display, false);
+        assert_eq!(placed.origin, gpui::point(px(1620.0), px(120.0)));
+        assert_eq!(placed.size, centered.size);
+        let placed = popup_bounds(&with("popup", None), centered, display, false);
+        assert_eq!(placed.origin, gpui::point(px(1620.0), px(160.0)));
+
+        assert_eq!(popup_bounds(&with("layerShell", None), centered, display, true), centered);
+        assert_eq!(popup_bounds(&WindowOptions::default(), centered, display, false), centered);
+        assert_eq!(popup_bounds(&with("popup", None), centered, None, false), centered);
+        let explicit = WindowOptions { x: Some(5.0), y: Some(6.0), ..with("popup", None) };
+        assert_eq!(popup_bounds(&explicit, centered, display, false), centered);
+    }
+
+    #[cfg(target_os = "linux")]
