+    fn x11_popups_open_on_the_monitor_under_the_pointer() {
+        let monitor = |x: i32, width: i32, height: i32, primary: bool| X11Monitor { x, y: 0, width, height, primary };
+        let (left, right) = (monitor(0, 1280, 800, true), monitor(1280, 1024, 600, false));
+        let both = [left, right];
+
+        assert_eq!(pick_x11_monitor(&both, Some((1500, 100))), Some(right));
+        assert_eq!(pick_x11_monitor(&both, Some((1279, 799))), Some(left));
+        assert_eq!(pick_x11_monitor(&both, Some((1500, 700))), Some(left), "off every monitor: the primary");
+        assert_eq!(pick_x11_monitor(&both, None), Some(left));
+        assert_eq!(pick_x11_monitor(&[right, monitor(2304, 800, 600, false)], None), Some(right), "no primary: the first");
+        assert_eq!(pick_x11_monitor(&[], Some((0, 0))), None);
+
+        let px = |value: f32| gpui::px(value);
+        let launcher = gpui::Bounds { origin: gpui::point(px(0.0), px(0.0)), size: gpui::size(px(600.0), px(56.0)) };
+        let display = gpui::Bounds {
+            origin: gpui::point(px(right.x as f32), px(right.y as f32)),
+            size: gpui::size(px(right.width as f32), px(right.height as f32)),
+        };
+        let popup = WindowOptions { kind: Some("popup".to_string()), ..WindowOptions::default() };
+        let placed = popup_bounds(&popup, launcher, Some(display), false);
+        assert_eq!(placed.origin, gpui::point(px(1492.0), px(160.0)));
+    }
