+/// X11 popups (and the layer-shell fallback) open where a top-anchored layer surface sits:
+/// centered horizontally, `layer_margin_top` below the display top. Explicit `x`/`y` win.
+#[cfg(target_os = "linux")]
+fn popup_bounds(
+    options: &WindowOptions,
+    bounds: gpui::Bounds<gpui::Pixels>,
+    display: Option<gpui::Bounds<gpui::Pixels>>,
+    layer_shell: bool,
+) -> gpui::Bounds<gpui::Pixels> {
+    let popup = match options.kind.as_deref() {
+        Some("popup") => true,
+        Some("layerShell") => !layer_shell,
+        _ => false,
+    };
+    match display {
+        Some(display) if popup && (options.x.is_none() || options.y.is_none()) => gpui::Bounds {
+            origin: gpui::point(
+                display.origin.x + (display.size.width - bounds.size.width) * 0.5,
+                display.origin.y + gpui::px(options.layer_margin_top.unwrap_or(160.0) as f32),
+            ),
+            size: bounds.size,
+        },
+        _ => bounds,
+    }
+}
+
+/// No compositor picks an output on X11: a placed popup moves to the monitor under
+/// the pointer each time it opens or shows, as layer surfaces follow the active output.
+#[cfg(target_os = "linux")]
+fn place_x11_popup(window: &gpui::Window, options: &WindowOptions) {
+    use x11rb::connection::Connection as _;
+    use x11rb::protocol::xproto::{ConfigureWindowAux, ConnectionExt as _};
+
+    let Some((xcb, x_window)) = x11_connection(window) else {
+        return;
+    };
+    let (root, monitors) = x11_monitors(&xcb, x_window);
+    let pointer = root
+        .and_then(|root| xcb.query_pointer(root).ok())
+        .and_then(|cookie| cookie.reply().ok())
+        .map(|reply| (i32::from(reply.root_x), i32::from(reply.root_y)));
+    let Some(monitor) = pick_x11_monitor(&monitors, pointer) else {
+        return;
+    };
+    let scale = window.scale_factor();
+    let logical = |value: i32| gpui::px(value as f32 / scale);
+    let display = gpui::Bounds {
+        origin: gpui::point(logical(monitor.x), logical(monitor.y)),
+        size: gpui::size(logical(monitor.width), logical(monitor.height)),
+    };
+    let current = window.bounds();
+    let placed = popup_bounds(options, current, Some(display), false);
+    if placed.origin == current.origin {
+        return;
+    }
+    let physical = |value: gpui::Pixels| (f32::from(value) * scale).round() as i32;
+    xcb.configure_window(x_window, &ConfigureWindowAux::new().x(physical(placed.origin.x)).y(physical(placed.origin.y)))
+        .map(|cookie| cookie.ignore_error())
+        .ok();
+    xcb.flush().ok();
+}
