+/// No window manager sees override-redirect (popup) windows on X11, so
+/// `activate_window()`'s `_NET_ACTIVE_WINDOW` request never focuses them.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn focus_x11_override_redirect(window: &gpui::Window) {
+    use x11rb::connection::Connection as _;
+    use x11rb::protocol::xproto::{ConnectionExt as _, InputFocus};
+
+    let Some((xcb, x_window)) = x11_connection(window) else {
+        return;
+    };
+    let override_redirect = xcb
+        .get_window_attributes(x_window)
+        .ok()
+        .and_then(|cookie| cookie.reply().ok())
+        .is_some_and(|attributes| attributes.override_redirect);
+    if override_redirect {
+        xcb.set_input_focus(InputFocus::PARENT, x_window, x11rb::CURRENT_TIME)
+            .map(|cookie| cookie.ignore_error())
+            .ok();
+        xcb.flush().ok();
+    }
+}
+
+/// A keyboard grab (e.g. a global shortcut's passive grab) sends FocusOut
+/// without moving focus; GPUI reports it as deactivation all the same.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn x11_holds_input_focus(window: &gpui::Window) -> bool {
+    use x11rb::protocol::xproto::ConnectionExt as _;
+
+    x11_connection(window).is_some_and(|(xcb, x_window)| {
+        xcb.get_input_focus()
+            .ok()
+            .and_then(|cookie| cookie.reply().ok())
+            .is_some_and(|reply| reply.focus == x_window)
+    })
+}
+
+/// GPUI's own XCB connection and the window's X id, or `None` off X11.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+#[allow(unsafe_code, reason = "GPUI exposes its XCB connection only as a raw handle")]
+fn x11_connection(window: &gpui::Window) -> Option<(x11rb::xcb_ffi::XCBConnection, u32)> {
+    use raw_window_handle::{HasDisplayHandle, HasWindowHandle, RawDisplayHandle, RawWindowHandle};
+
+    let (Ok(RawWindowHandle::Xcb(handle)), Ok(RawDisplayHandle::Xcb(display))) = (
+        HasWindowHandle::window_handle(window).map(|handle| handle.as_raw()),
+        HasDisplayHandle::display_handle(window).map(|handle| handle.as_raw()),
+    ) else {
+        return None;
+    };
+    // SAFETY: GPUI's live connection, borrowed on its own thread; should_drop = false.
+    let xcb = unsafe { x11rb::xcb_ffi::XCBConnection::from_raw_xcb_connection(display.connection?.as_ptr(), false) };
+    Some((xcb.ok()?, handle.window.get()))
+}
