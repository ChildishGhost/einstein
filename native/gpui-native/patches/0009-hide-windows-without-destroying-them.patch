+/// GPUI has no per-window hide; on X11 unmap/map keeps the window and its id.
+/// Returns `false` off X11.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn set_x11_mapped(window: &gpui::Window, mapped: bool) -> bool {
+    use x11rb::connection::Connection as _;
+    use x11rb::protocol::xproto::ConnectionExt as _;
+
+    let Some((xcb, x_window)) = x11_connection(window) else {
+        return false;
+    };
+    let sent = if mapped { xcb.map_window(x_window) } else { xcb.unmap_window(x_window) };
+    sent.map(|cookie| cookie.ignore_error()).is_ok() && xcb.flush().is_ok()
+}
