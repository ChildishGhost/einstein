+        if self.key_capture == capture {
+            return;
+        }
+        self.key_capture = capture;
+        self.key_capture_subscription = (self.key_capture != KeyCapture::None).then(|| {
+            let state = cx.weak_entity();
+            // Interceptors run before key bindings, so a window-root binding (Tab: focus next)
+            // cannot claim the key first.
+            cx.intercept_keystrokes(move |event, window, cx| {
+                if let Some(state) = state.upgrade() {
+                    Self::capture_key_down(&state, &event.keystroke, window, cx);
+                }
