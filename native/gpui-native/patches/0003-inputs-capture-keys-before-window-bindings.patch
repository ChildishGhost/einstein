+fn emit_key_down(
+    callback: &Option<EventCallback>,
+    element_id: u64,
+    keystroke: &Keystroke,
+    is_held: Option<bool>,
+) {
+    emit_event_full(callback, element_id, "keyDown", |payload| {
+        payload.key = Some(keystroke.key.clone());
+        payload.key_char.clone_from(&keystroke.key_char);
+        payload.is_held = is_held;
+        payload.modifiers = Some(keystroke.modifiers.into());
+    });
+}
