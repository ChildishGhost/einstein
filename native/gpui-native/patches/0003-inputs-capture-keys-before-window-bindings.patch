+/// `captureKeys`: key-downs the focused editor keeps from ancestor bindings and listeners.
+#[derive(Clone, Default, PartialEq)]
+enum KeyCapture {
+    #[default]
+    None,
+    All,
+    Keys(Vec<Keystroke>),
+}
+
+impl KeyCapture {
+    fn from_prop(value: &serde_json::Value) -> Self {
+        match value {
+            serde_json::Value::String(all) if all == "all" => Self::All,
+            serde_json::Value::Array(keys) => Self::Keys(
+                keys.iter()
+                    .filter_map(serde_json::Value::as_str)
+                    .filter_map(|key| Keystroke::parse(key).ok())
+                    .collect(),
+            ),
+            _ => Self::None,
+        }
+    }
+
+    fn captures(&self, keystroke: &Keystroke) -> bool {
+        match self {
+            Self::None => false,
+            Self::All => true,
+            Self::Keys(keys) => keys
+                .iter()
+                .any(|key| key.key == keystroke.key && key.modifiers == keystroke.modifiers),
+        }
+    }
+}
