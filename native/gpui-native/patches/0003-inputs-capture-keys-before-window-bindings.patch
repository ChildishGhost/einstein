+/// The editor's own binding for `keystroke`, ignoring bindings of ancestor contexts.
+fn own_binding(context: &str, keystroke: &Keystroke, cx: &App) -> Option<Box<dyn gpui::Action>> {
+    let predicate = KeyBindingContextPredicate::parse(context).ok()?;
+    let context = KeyContext::parse(context).ok()?;
+    let (bindings, _) = cx
+        .key_bindings()
+        .borrow()
+        .bindings_for_input(std::slice::from_ref(keystroke), &[context]);
+    bindings
+        .into_iter()
+        .find(|binding| binding.predicate().is_some_and(|own| *own == predicate))
+        .map(|binding| binding.action().boxed_clone())
+}
