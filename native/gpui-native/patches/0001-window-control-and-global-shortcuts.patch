@@ -0,0 +1,339 @@
+//! Global (system-wide) shortcuts, registered at runtime.
+//!
+//! * Wayland: the XDG `GlobalShortcuts` portal. The app *requests* shortcuts;
+//!   the desktop (e.g. KDE) binds them, may ask the user, remembers the choice
+//!   per app id, and lets the user change the key in its own settings.
+//! * X11 / macOS / Windows: OS hotkey APIs via the `global-hotkey` crate
+//!   (XGrabKey / Carbon / RegisterHotKey).
+//!
+//! Results arrive through the renderer's event callback:
+//! `globalShortcut` (value = shortcut id) on activation, and
+//! `globalShortcutStatus` (value = JSON) when binding succeeds or fails.
+
+use std::sync::mpsc as std_mpsc;
+use std::thread;
+
+use crate::element_tree::EventPayload;
+use crate::renderer::EventCallback;
+
+#[derive(Clone, Debug, serde::Deserialize)]
+pub struct ShortcutSpec {
+    pub id: String,
+    /// "Meta+Space", "Ctrl+Alt+K", … (Meta/Super/Logo/Cmd are the same key).
+    pub accelerator: String,
+    pub description: String,
+}
+
+pub(crate) enum Command {
+    Bind(Vec<ShortcutSpec>),
+    Configure,
+    Stop,
+}
+
+pub(crate) struct GlobalShortcuts {
+    commands: Option<CommandSender>,
+}
+
+enum CommandSender {
+    #[cfg(target_os = "linux")]
+    Portal(futures::channel::mpsc::UnboundedSender<Command>),
+    #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+    Hotkey(std_mpsc::Sender<Command>),
+}
+
+impl GlobalShortcuts {
+    pub(crate) fn new() -> Self {
+        Self { commands: None }
+    }
+
+    /// Replace the bound set with `shortcuts` (starting the backend lazily).
+    pub(crate) fn bind(&mut self, app_id: String, shortcuts: Vec<ShortcutSpec>, callback: Option<EventCallback>) {
+        if self.commands.is_none() {
+            self.commands = Some(start_backend(app_id, callback));
+        }
+        self.send(Command::Bind(shortcuts));
+    }
+
+    /// Open the desktop's own shortcut configuration (portal v2+).
+    pub(crate) fn configure(&self) {
+        self.send(Command::Configure);
+    }
+
+    pub(crate) fn stop(&mut self) {
+        self.send(Command::Stop);
+        self.commands = None;
+    }
+
+    fn send(&self, command: Command) {
+        match &self.commands {
+            #[cfg(target_os = "linux")]
+            Some(CommandSender::Portal(sender)) => {
+                sender.unbounded_send(command).ok();
+            }
+            #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+            Some(CommandSender::Hotkey(sender)) => {
+                sender.send(command).ok();
+            }
+            _ => {}
+        }
+    }
+}
+
+fn emit(callback: &Option<EventCallback>, event_type: &str, value: String) {
+    if let Some(callback) = callback {
+        callback(EventPayload {
+            element_id: 0.0,
+            event_type: event_type.to_string(),
+            value: Some(value),
+            ..Default::default()
+        });
+    }
+}
+
+fn status(callback: &Option<EventCallback>, backend: &str, state: &str, detail: serde_json::Value) {
+    let mut value = serde_json::json!({ "backend": backend, "state": state });
+    if let (Some(object), serde_json::Value::Object(extra)) = (value.as_object_mut(), detail) {
+        object.extend(extra);
+    }
+    emit(callback, "globalShortcutStatus", value.to_string());
+}
+
+fn start_backend(app_id: String, callback: Option<EventCallback>) -> CommandSender {
+    #[cfg(target_os = "linux")]
+    if std::env::var_os("WAYLAND_DISPLAY").is_some() {
+        let (sender, receiver) = futures::channel::mpsc::unbounded();
+        thread::Builder::new()
+            .name("global-shortcuts-portal".into())
+            .spawn(move || futures::executor::block_on(portal::run(app_id, receiver, callback)))
+            .ok();
+        return CommandSender::Portal(sender);
+    }
+    let _ = &app_id;
+    let (sender, receiver) = std_mpsc::channel();
+    thread::Builder::new()
+        .name("global-shortcuts-hotkey".into())
+        .spawn(move || hotkey::run(receiver, callback))
+        .ok();
+    CommandSender::Hotkey(sender)
+}
+
+/// "Meta+Space" → XDG shortcuts-spec trigger "LOGO+space".
+#[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+fn portal_trigger(accelerator: &str) -> String {
+    accelerator
+        .split('+')
+        .map(|part| match part.trim().to_ascii_lowercase().as_str() {
+            "meta" | "super" | "logo" | "cmd" | "command" | "win" => "LOGO".to_string(),
+            "ctrl" | "control" => "CTRL".to_string(),
+            "alt" | "option" => "ALT".to_string(),
+            "shift" => "SHIFT".to_string(),
+            key => key.to_string(),
+        })
+        .collect::<Vec<_>>()
+        .join("+")
+}
+
+#[cfg(target_os = "linux")]
+mod portal {
+    use ashpd::desktop::global_shortcuts::{BindShortcutsOptions, GlobalShortcuts, NewShortcut};
+    use futures::{FutureExt, StreamExt};
+
+    use super::{Command, EventCallback, ShortcutSpec, emit, portal_trigger, status};
+
+    pub(super) async fn run(
+        app_id: String,
+        mut commands: futures::channel::mpsc::UnboundedReceiver<Command>,
+        callback: Option<EventCallback>,
+    ) {
+        // Non-sandboxed apps must tell the portal who they are (matches the
+        // installed <app_id>.desktop file); the desktop stores bindings per id.
+        // That association is per D-Bus connection and must come first, and
+        // GPUI has already used the shared session connection for other
+        // portals — so shortcuts get a connection of their own.
+        let connection = match ashpd::zbus::connection::Builder::session() {
+            Ok(builder) => builder.build().await,
+            Err(error) => Err(error),
+        };
+        let connection = match connection {
+            Ok(connection) => connection,
+            Err(error) => {
+                status(&callback, "portal", "unavailable", serde_json::json!({ "error": error.to_string() }));
+                return;
+            }
+        };
+        match app_id.parse() {
+            Ok(id) => {
+                if let Err(error) = ashpd::register_host_app_with_connection(connection.clone(), id).await {
+                    status(&callback, "portal", "register-failed", serde_json::json!({ "appId": app_id, "error": error.to_string() }));
+                }
+            }
+            Err(error) => {
+                status(&callback, "portal", "register-failed", serde_json::json!({ "appId": app_id, "error": error.to_string() }));
+            }
+        }
+        let proxy = match GlobalShortcuts::with_connection(connection).await {
+            Ok(proxy) => proxy,
+            Err(error) => {
+                status(&callback, "portal", "unavailable", serde_json::json!({ "error": error.to_string() }));
+                return;
+            }
+        };
+        let mut activated = match proxy.receive_activated().await {
+            Ok(stream) => stream.fuse(),
+            Err(error) => {
+                status(&callback, "portal", "unavailable", serde_json::json!({ "error": error.to_string() }));
+                return;
+            }
+        };
+        let mut session = None;
+        loop {
+            futures::select! {
+                event = activated.next() => {
+                    let Some(event) = event else { break };
+                    emit(&callback, "globalShortcut", event.shortcut_id().to_string());
+                }
+                command = commands.next().fuse() => match command {
+                    Some(Command::Bind(shortcuts)) => {
+                        // A fresh session per bind: closing the old one releases its shortcuts.
+                        if let Some(old) = session.take() {
+                            let old: ashpd::desktop::Session<GlobalShortcuts> = old;
+                            old.close().await.ok();
+                        }
+                        session = bind(&proxy, &shortcuts, &callback).await;
+                    }
+                    Some(Command::Configure) => {
+                        if let Some(active) = &session {
+                            if let Err(error) = proxy.configure_shortcuts(active, None, Default::default()).await {
+                                status(&callback, "portal", "configure-failed", serde_json::json!({ "error": error.to_string() }));
+                            }
+                        }
+                    }
+                    Some(Command::Stop) | None => break,
+                },
+            }
+        }
+        if let Some(active) = session {
+            active.close().await.ok();
+        }
+    }
+
+    async fn bind(
+        proxy: &GlobalShortcuts,
+        shortcuts: &[ShortcutSpec],
+        callback: &Option<EventCallback>,
+    ) -> Option<ashpd::desktop::Session<GlobalShortcuts>> {
+        let session = match proxy.create_session(Default::default()).await {
+            Ok(session) => session,
+            Err(error) => {
+                status(callback, "portal", "failed", serde_json::json!({ "error": error.to_string() }));
+                return None;
+            }
+        };
+        let triggers: Vec<String> = shortcuts.iter().map(|s| portal_trigger(&s.accelerator)).collect();
+        let requested: Vec<NewShortcut> = shortcuts
+            .iter()
+            .zip(&triggers)
+            .map(|(spec, trigger)| NewShortcut::new(spec.id.clone(), spec.description.clone()).preferred_trigger(trigger.as_str()))
+            .collect();
+        let response = match proxy.bind_shortcuts(&session, &requested, None, BindShortcutsOptions::default()).await {
+            Ok(request) => request.response(),
+            Err(error) => Err(error),
+        };
+        match response {
+            Ok(bound) => {
+                let bound: Vec<_> = bound
+                    .shortcuts()
+                    .iter()
+                    .map(|s| serde_json::json!({ "id": s.id(), "trigger": s.trigger_description() }))
+                    .collect();
+                status(callback, "portal", "bound", serde_json::json!({ "shortcuts": bound, "version": proxy.version() }));
+                Some(session)
+            }
+            Err(error) => {
+                // Includes the user cancelling the desktop's dialog.
+                status(callback, "portal", "failed", serde_json::json!({ "error": error.to_string() }));
+                session.close().await.ok();
+                None
+            }
+        }
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+mod hotkey {
+    use std::collections::HashMap;
+    use std::str::FromStr;
+    use std::sync::mpsc::{Receiver, RecvTimeoutError};
+    use std::time::Duration;
+
+    use global_hotkey::hotkey::HotKey;
+    use global_hotkey::{GlobalHotKeyEvent, GlobalHotKeyManager, HotKeyState};
+
+    use super::{Command, EventCallback, emit, status};
+
+    /// "Meta+Space" → global-hotkey syntax "super+space".
+    fn parse(accelerator: &str) -> Result<HotKey, String> {
+        let normalized = accelerator
+            .split('+')
+            .map(|part| match part.trim().to_ascii_lowercase().as_str() {
+                "meta" | "logo" | "win" => "super".to_string(),
+                other => other.to_string(),
+            })
+            .collect::<Vec<_>>()
+            .join("+");
+        HotKey::from_str(&normalized).map_err(|error| error.to_string())
+    }
+
+    // NOTE: on Windows the hotkey thread needs a message loop and on macOS
+    // registration must happen on the main thread; this worker thread is
+    // verified only on Linux/X11-style setups (see README).
+    pub(super) fn run(commands: Receiver<Command>, callback: Option<EventCallback>) {
+        let manager = match GlobalHotKeyManager::new() {
+            Ok(manager) => manager,
+            Err(error) => {
+                status(&callback, "hotkey", "unavailable", serde_json::json!({ "error": error.to_string() }));
+                return;
+            }
+        };
+        let mut bound: HashMap<u32, (String, HotKey)> = HashMap::new();
+        loop {
+            match commands.recv_timeout(Duration::from_millis(20)) {
+                Ok(Command::Bind(shortcuts)) => {
+                    for (_, (_, hotkey)) in bound.drain() {
+                        manager.unregister(hotkey).ok();
+                    }
+                    let mut results = Vec::new();
+                    for spec in shortcuts {
+                        match parse(&spec.accelerator).and_then(|hotkey| {
+                            manager.register(hotkey).map(|()| hotkey).map_err(|error| error.to_string())
+                        }) {
+                            Ok(hotkey) => {
+                                bound.insert(hotkey.id(), (spec.id.clone(), hotkey));
+                                results.push(serde_json::json!({ "id": spec.id, "trigger": spec.accelerator }));
+                            }
+                            Err(error) => {
+                                status(&callback, "hotkey", "failed", serde_json::json!({ "id": spec.id, "error": error }));
+                            }
+                        }
+                    }
+                    if !results.is_empty() {
+                        status(&callback, "hotkey", "bound", serde_json::json!({ "shortcuts": results }));
+                    }
+                }
+                Ok(Command::Configure) => {}
+                Ok(Command::Stop) | Err(RecvTimeoutError::Disconnected) => break,
+                Err(RecvTimeoutError::Timeout) => {}
+            }
+            while let Ok(event) = GlobalHotKeyEvent::receiver().try_recv() {
+                if event.state == HotKeyState::Pressed {
+                    if let Some((id, _)) = bound.get(&event.id) {
+                        emit(&callback, "globalShortcut", id.clone());
+                    }
+                }
+            }
+        }
+        for (_, (_, hotkey)) in bound {
+            manager.unregister(hotkey).ok();
+        }
+    }
+}
