+            self.visible.store(false, Ordering::Release);
+            let (close_sender, close_receiver) = sync_channel(1);
+            sender
+                .unbounded_send(UiCommand::Close { response: close_sender })
+                .map_err(|_| Error::from_reason("The GPUI UI thread is not running"))?;
+            return match close_receiver.recv_timeout(Duration::from_secs(2)) {
+                Ok(result) => result.map_err(Error::from_reason),
+                Err(_) => Err(Error::from_reason("Timed out waiting for GPUI to hide the window")),
+            };
+        }
+        #[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "freebsd")))]
+        Err(Error::from_reason("hideWindow is not supported on this platform yet"))
+    }
+
+    /// Reopen a hidden window (same tree, same options, remembered size) and
+    /// focus it; emits `windowShow`. Activates the window if already visible.
+    #[cfg_attr(not(target_family = "wasm"), napi)]
+    pub fn show_window(&self) -> Result<()> {
+        #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+        {
+            if !*self.initialized.lock() {
+                return Err(Error::from_reason("Renderer not initialized. Call init() first."));
+            }
+            if self.visible.load(std::sync::atomic::Ordering::Acquire) {
+                return self.send_ui_command(UiCommand::ActivateWindow);
+            }
+            let Some((callback, options)) = self.reopen.lock().clone() else {
+                return Err(Error::from_reason("Nothing to show"));
+            };
+            self.open_threaded_window(options, callback.clone())?;
+            emit_event_full(&callback, 0, "windowShow", |_| {});
+            return Ok(());
+        }
+        #[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "freebsd")))]
+        Err(Error::from_reason("showWindow is not supported on this platform yet"))
+    }
+
+    // ── Global shortcuts ─────────────────────────────────────────────
+
+    /// Register system-wide shortcuts (replacing any registered before).
+    /// `shortcuts_json`: `[{ "id", "accelerator": "Meta+Space", "description" }]`.
+    /// Wayland uses the GlobalShortcuts portal with `app_id` (reverse-DNS,
+    /// matching an installed `<app_id>.desktop`); elsewhere OS hotkey APIs.
+    /// Emits `globalShortcutStatus` (JSON) and `globalShortcut` (id) events.
+    #[cfg_attr(not(target_family = "wasm"), napi)]
+    pub fn register_global_shortcuts(&self, app_id: String, shortcuts_json: String) -> Result<()> {
+        #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+        {
+            let shortcuts: Vec<crate::global_shortcut::ShortcutSpec> =
+                serde_json::from_str(&shortcuts_json).map_err(|e| Error::from_reason(e.to_string()))?;
+            // The view callback outlives init (it is kept for showWindow()).
+            #[cfg(any(target_os = "windows", target_os = "linux"))]
+            let callback = self.reopen.lock().as_ref().and_then(|(callback, _)| callback.clone());
+            #[cfg(target_os = "macos")]
+            let callback = self.event_callback_for_view();
+            self.global_shortcuts.lock().bind(app_id, shortcuts, callback);
+            return Ok(());
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows")))]
+        {
+            let _ = (app_id, shortcuts_json);
+            Err(Error::from_reason("global shortcuts are not supported on this platform"))
+        }
+    }
+
+    /// Open the desktop's shortcut editor for our shortcuts (Wayland portal v2).
+    #[cfg_attr(not(target_family = "wasm"), napi)]
+    pub fn configure_global_shortcuts(&self) {
+        #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+        self.global_shortcuts.lock().configure();
+    }
+
+    #[cfg_attr(not(target_family = "wasm"), napi)]
