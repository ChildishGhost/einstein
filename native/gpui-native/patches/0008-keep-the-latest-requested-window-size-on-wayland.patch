+/// The latest `setWindowSize()` and how often it may still be re-requested.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+type RequestedSize = std::rc::Rc<std::cell::Cell<Option<(gpui::Size<gpui::Pixels>, u8)>>>;
+
+/// Bounds a compositor that keeps answering with another size.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+const REQUESTED_SIZE_RETRIES: u8 = 4;
+
+/// A layer-surface configure may answer an older `set_size`; GPUI applies it and
+/// re-requests that stale size, so the latest requested size is asserted again.
+#[cfg(target_os = "linux")]
+fn keep_requested_size(requested: &RequestedSize, window: &gpui::Window, cx: &gpui::App) {
+    let Some((size, retries)) = requested.get() else {
+        return;
+    };
+    if retries == 0 || window.viewport_size() == size {
+        return;
+    }
+    requested.set(Some((size, retries - 1)));
+    let requested = requested.clone();
+    // Deferred: GPUI sends set_size for the configured size after this observer returns.
+    window
+        .spawn(cx, async move |cx| {
+            cx.update(|window, _cx| match requested.get() {
+                Some((latest, _)) if window.viewport_size() != latest => window.resize(latest),
+                _ => {}
+            })
+            .ok();
+        })
+        .detach();
+}
