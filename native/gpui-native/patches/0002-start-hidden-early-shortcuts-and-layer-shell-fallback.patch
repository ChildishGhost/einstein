@@ -2410,6 +2432,25 @@ mod window_options_tests {
         assert!(hidden.focus);
         assert!(!hidden.show);
     }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn layer_shell_falls_back_to_popup_only_when_the_compositor_lacks_it() {
+        let layer_shell = WindowOptions {
+            kind: Some("layerShell".to_string()),
+            ..WindowOptions::default()
+        };
+        let unsupported: gpui::Result<()> = Err(gpui::layer_shell::LayerShellNotSupportedError.into());
+        let other: gpui::Result<()> = Err(std::io::Error::other("no display").into());
+
+        let fallback = layer_shell_fallback(&layer_shell, &unsupported).expect("popup fallback");
+        assert_eq!(fallback.kind.as_deref(), Some("popup"));
+        assert!(matches!(mapped(fallback).kind, gpui::WindowKind::PopUp));
+
+        assert!(layer_shell_fallback(&layer_shell, &Ok(())).is_none());
+        assert!(layer_shell_fallback(&layer_shell, &other).is_none());
+        assert!(layer_shell_fallback(&WindowOptions::default(), &unsupported).is_none());
+    }
 }
 
