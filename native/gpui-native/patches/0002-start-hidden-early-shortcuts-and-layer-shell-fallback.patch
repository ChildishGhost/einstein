+/// Wayland compositors without zwlr_layer_shell_v1 (e.g. GNOME) get a popup instead.
+#[cfg(target_os = "linux")]
+fn layer_shell_fallback<T>(options: &WindowOptions, opened: &gpui::Result<T>) -> Option<WindowOptions> {
+    let unsupported = opened.as_ref().is_err_and(|error| {
+        error.downcast_ref::<gpui::layer_shell::LayerShellNotSupportedError>().is_some()
+    });
+    (unsupported && options.kind.as_deref() == Some("layerShell")).then(|| WindowOptions {
+        kind: Some("popup".to_string()),
+        ..options.clone()
+    })
+}
