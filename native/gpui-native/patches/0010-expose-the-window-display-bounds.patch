+#[cfg(not(target_family = "wasm"))]
+fn display_bounds(window: &gpui::Window, cx: &gpui::App) -> Option<Vec<f64>> {
+    #[cfg(any(target_os = "linux", target_os = "freebsd"))]
+    if let Some(monitor) = x11_window_monitor(window) {
+        let scale = f64::from(window.scale_factor());
+        return Some(
+            [monitor.x, monitor.y, monitor.width, monitor.height].map(|value| f64::from(value) / scale).to_vec(),
+        );
+    }
+    // GPUI updates the window's display only on resize, so a Wayland window that has
+    // not resized since entering its output has none yet; a single display is unambiguous.
+    let display = window.display(cx).or_else(|| match cx.displays().as_slice() {
+        [only] => Some(only.clone()),
+        _ => None,
+    })?;
+    let bounds = display.visible_bounds();
+    Some(
+        [bounds.origin.x, bounds.origin.y, bounds.size.width, bounds.size.height]
+            .map(|value| f64::from(f32::from(value)))
+            .to_vec(),
+    )
+}
