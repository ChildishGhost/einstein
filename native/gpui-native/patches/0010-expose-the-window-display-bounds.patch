+/// An X11 RandR monitor in physical pixels.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct X11Monitor {
+    x: i32,
+    y: i32,
+    width: i32,
+    height: i32,
+    primary: bool,
+}
+
+/// The monitor holding `point`, else the primary one, else the first.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn pick_x11_monitor(monitors: &[X11Monitor], point: Option<(i32, i32)>) -> Option<X11Monitor> {
+    let holds = |monitor: &&X11Monitor| {
+        point.is_some_and(|(x, y)| {
+            (monitor.x..monitor.x + monitor.width).contains(&x) && (monitor.y..monitor.y + monitor.height).contains(&y)
+        })
+    };
+    monitors
+        .iter()
+        .find(holds)
+        .or_else(|| monitors.iter().find(|monitor| monitor.primary))
+        .or_else(|| monitors.first())
+        .copied()
+}
+
+/// GPUI's X11 display is the whole X screen, spanning every monitor; RandR splits it.
+/// Empty without RandR 1.5.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn x11_monitors(xcb: &x11rb::xcb_ffi::XCBConnection, x_window: u32) -> (Option<u32>, Vec<X11Monitor>) {
+    use x11rb::protocol::randr::ConnectionExt as _;
+    use x11rb::protocol::xproto::ConnectionExt as _;
+
+    let Some(root) = xcb.get_geometry(x_window).ok().and_then(|cookie| cookie.reply().ok()).map(|reply| reply.root)
+    else {
+        return (None, Vec::new());
+    };
+    let monitors = xcb
+        .randr_get_monitors(root, true)
+        .ok()
+        .and_then(|cookie| cookie.reply().ok())
+        .map(|reply| {
+            reply
+                .monitors
+                .iter()
+                .map(|monitor| X11Monitor {
+                    x: monitor.x.into(),
+                    y: monitor.y.into(),
+                    width: monitor.width.into(),
+                    height: monitor.height.into(),
+                    primary: monitor.primary,
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    (Some(root), monitors)
+}
+
+/// The monitor under the window's center, or `None` off X11 or without RandR.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn x11_window_monitor(window: &gpui::Window) -> Option<X11Monitor> {
+    let (xcb, x_window) = x11_connection(window)?;
+    let (_, monitors) = x11_monitors(&xcb, x_window);
+    let (center, scale) = (window.bounds().center(), window.scale_factor());
+    let center = ((f32::from(center.x) * scale).round() as i32, (f32::from(center.y) * scale).round() as i32);
+    pick_x11_monitor(&monitors, Some(center))
+}
