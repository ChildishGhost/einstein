{
	"compilerOptions": {
		"strict": true
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@1.0.19",
		"@std/fs": "jsr:@std/fs@1.0.24",
		"@std/path": "jsr:@std/path@1.1.6",
		"@std/testing": "jsr:@std/testing@1.0.21",
		"einstein": "./src/pluginHost.deno/preload/einstein.ts",
		"fuse.js": "./src/pluginHost.deno/preload/fuse.ts"
	},
	"tasks": {
		"dev": "deno run --no-prompt --allow-all src/main.deno/index.ts",
		"build": "deno task build:ui && deno task build:hosts && deno task build:plugins",
		"install:ui": "deno install --frozen --config src/ui.deno/deno.json",
		"build:ui": "deno run --no-prompt --allow-all npm:vite build --config src/ui.deno/vite.config.ts",
		"build:hosts": "deno check src/main.deno/ src/pluginHost.deno/",
		"build:plugins": "npx webpack --config-name plugins --config-name plugins:module",
		"test": "deno test --allow-all",
		"native:fetch": "deno run --no-prompt --allow-read --allow-write --allow-run=git .bin/native-fetch.mts",
		"native:build": "deno run --no-prompt --allow-env=CONTAINER_ENGINE --allow-run .bin/native-build.mts",
		"desktop-entry:install": "deno run --no-prompt --allow-env=XDG_DATA_HOME,HOME --allow-write .bin/desktop-entry.mts install",
		"desktop-entry:remove": "deno run --no-prompt --allow-env=XDG_DATA_HOME,HOME --allow-write .bin/desktop-entry.mts remove",
		"capture:launcher": "deno run --no-prompt --allow-env=XDG_CURRENT_DESKTOP,SPECTACLE --allow-read --allow-write --allow-run .bin/capture-launcher.mts"
	},
	"test": {
		"include": [
			"tests/**/*.test.ts"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 120,
		"singleQuote": true,
		"semiColons": false,
		"include": [
			"deno.json",
			".bin/*.ts",
			".bin/*.mts",
			"src/main.deno/",
			"src/ui.deno/",
			"src/pluginHost.deno/",
			"tests/**/*.ts"
		]
	},
	"lint": {
		"include": [
			".bin/*.ts",
			".bin/*.mts",
			"src/main.deno/",
			"src/ui.deno/",
			"src/pluginHost.deno/",
			"src/common/**/*.deno.ts",
			"tests/**/*.ts"
		]
	}
}
