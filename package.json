{
	"name": "einstein",
	"version": "0.0.1",
	"main": "./dist/main/main.js",
	"scripts": {
		"postinstall": "patch-package",
		"build": "npm run build:webpack && npm run build:electron",
		"build:webpack": "webpack",
		"build:electron": ".bin/build-electron.sh",
		"clean": "rm -rf node_modules && rm -rf dist/{electron,main,node,plugins,renderer}",
		"lint": "eslint",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier -w src/ plugins/ && eslint --fix",
		"run": "npm run build:webpack && electron .",
		"run:without-build": "electron .",
		"watch": "webpack --watch"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@babel/core": "^7.29.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^10.0.0",
		"@types/node": "^16.11.19",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vue/compiler-sfc": "^3.5.28",
		"babel-loader": "^10.0.0",
		"babel-plugin-module-resolver": "^5.0.2",
		"clean-webpack-plugin": "^4.0.0",
		"create-file-webpack": "^1.0.2",
		"css-loader": "^7.1.4",
		"electron": "^40.8.5",
		"electron-debug": "^4.1.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-tsdoc": "^0.5.2",
		"eslint-plugin-vue": "^10.8.0",
		"eslint-webpack-plugin": "^6.0.0",
		"globals": "^17.3.0",
		"html-webpack-plugin": "^5.6.7",
		"mini-css-extract-plugin": "^2.10.0",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.1",
		"prettier-eslint": "^16.4.2",
		"sass": "^1.98.0",
		"sass-loader": "^16.0.6",
		"ts-loader": "^9.5.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vue-eslint-parser": "^10.4.0",
		"vue-loader": "^17.4.2",
		"webpack": "^5.105.2",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^6.0.0",
		"webpack-hot-middleware": "^2.26.1",
		"webpack-merge": "^6.0.1"
	},
	"dependencies": {
		"comment-json": "^4.5.1",
		"fuse.js": "^7.1.0",
		"source-map-support": "^0.5.21",
		"vm2": "^3.11.5",
		"vue": "^3.5.27"
	}
}
