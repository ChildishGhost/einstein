{
	"name": "einstein",
	"version": "0.0.1",
	"main": "./dist/main/main.js",
	"scripts": {
		"postinstall": "patch-package",
		"build": "npm run build:webpack && npm run build:electron",
		"build:webpack": "webpack",
		"build:electron": ".bin/build-electron.sh",
		"clean": "rm -rf node_modules && rm -rf dist/{electron,main,node,plugins,renderer}",
		"lint": "eslint",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier -w src/ plugins/ && eslint --fix",
		"run": "npm run build:webpack && electron .",
		"run:without-build": "electron .",
		"watch": "webpack --watch"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.14.1",
		"@babel/core": "^7.27.4",
		"@eslint/compat": "^1.2.8",
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.19.0",
		"@types/node": "^16.11.19",
		"@typescript-eslint/eslint-plugin": "^8.34.0",
		"@typescript-eslint/parser": "^8.34.0",
		"@vue/compiler-sfc": "^3.5.12",
		"babel-loader": "^10.0.0",
		"babel-plugin-module-resolver": "^5.0.2",
		"clean-webpack-plugin": "^4.0.0",
		"create-file-webpack": "^1.0.2",
		"css-loader": "^7.1.2",
		"electron": "^35.0.1",
		"electron-debug": "^4.1.0",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^4.4.3",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-tsdoc": "^0.4.0",
		"eslint-plugin-vue": "^10.2.0",
		"eslint-webpack-plugin": "^5.0.2",
		"globals": "^16.2.0",
		"html-webpack-plugin": "^5.6.3",
		"mini-css-extract-plugin": "^2.9.1",
		"patch-package": "^8.0.0",
		"prettier": "^3.5.1",
		"prettier-eslint": "^16.4.2",
		"sass": "^1.89.1",
		"sass-loader": "^16.0.5",
		"ts-loader": "^9.5.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.36.0",
		"vue-eslint-parser": "^10.1.3",
		"vue-loader": "^17.4.2",
		"webpack": "^5.97.1",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.1",
		"webpack-hot-middleware": "^2.26.1",
		"webpack-merge": "^6.0.1"
	},
	"dependencies": {
		"comment-json": "^4.2.5",
		"fuse.js": "^7.1.0",
		"source-map-support": "^0.5.21",
		"vm2": "^3.9.19",
		"vue": "^3.5.13"
	}
}
